#!/bin/sh
echo "S98lddmodules started"

#remember to chmod +x 
#chmod +x S98lddmodules

case "$1" in
    start)
        echo "Loading scull driver..."
        # Load the module
        if insmod /lib/modules/$(uname -r)/extra/scull.ko; then
            # Create device nodes (major number may vary, check 'cat /proc/devices')
            MAJOR=$(awk "\$2==\"scull\" {print \$1}" /proc/devices)
            mknod /dev/scull0 c $MAJOR 0
            mknod /dev/scull1 c $MAJOR 1
            mknod /dev/scull2 c $MAJOR 2
            mknod /dev/scull3 c $MAJOR 3
            echo "OK"
        else
            echo "FAIL"
        fi
        ;;
    stop)
        echo "Unloading scull driver..."
        rmmod scull
        rm -f /dev/scull[0-3]
        ;;
    restart)
        $0 stop
        $0 start
        ;;  
    *)
        echo "Usage: $0 {start|stop}"
        exit 1
        ;;
esac


case "$1" in
  start)
    printf "Loading misc-modules... "
    mkdir /lib/modules/$(uname -r)/misc/
    cp /lib/modules/$(uname -r)/extra/*.ko /lib/modules/$(uname -r)/misc/
    #sudo depmod -a
