BR2_KERNEL_HEADERS_5_15=y
BR2_PACKAGE_GLIBC_UTILS=y
BR2_CCACHE=y
# BR2_CCACHE_USE_BASEDIR is not set
BR2_SHARED_STATIC_LIBS=y
BR2_TARGET_GENERIC_PASSWD_SHA512=y
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
BR2_ROOTFS_MERGED_USR=y
